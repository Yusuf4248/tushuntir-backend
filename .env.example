# Copy to .env and fill in. Never commit .env.
PORT=4004

# PostgreSQL (pgvector extension required)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=school_platform

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Auth: long random strings, different from each other
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# npm run seed:admin creates the first super_admin
SEED_ADMIN_PHONE=+998900000000
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# AI: Claude for chat, Voyage for embeddings (1024-dim vectors)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EMBEDDING_MODEL=voyage-4
AI_EMBEDDING_API_KEY=
AI_TIMEOUT_MS=60000
