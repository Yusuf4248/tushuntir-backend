# Copy to .env and fill in. Never commit .env. Full list and production values: docs/DEPLOY.md
PORT=4004
# production on the server: NODE_ENV=production (here in .env, so scripts see it too)
NODE_ENV=
# Listen address: 127.0.0.1 on the server (only Caddy reaches the app); default 0.0.0.0
HOST=
# Comma-separated frontend origins, e.g. https://school-platform.vercel.app (unset: any origin, local only)
CORS_ORIGINS=
# Uploaded files, private homework submissions (private/) and the Sardor voice cache.
# Default: /var/lib/tushuntir/uploads with NODE_ENV=production, else ./uploads
UPLOADS_DIR=
# Write logs/combine.log and logs/error.log (default true, false when NODE_ENV=production)
LOG_TO_FILE=

# PostgreSQL with the pgvector extension: either DATABASE_URL (wins) or the PG_* variables
DATABASE_URL=
PG_SSL=
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DB=school_platform

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Auth: long random strings, different from each other
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# npm run seed:admin creates the first super_admin
SEED_ADMIN_PHONE=+998900000000
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=

# AI: Claude for chat, Voyage for embeddings (1024-dim vectors)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_EMBEDDING_MODEL=voyage-4
AI_EMBEDDING_API_KEY=
AI_TIMEOUT_MS=60000

# Speech: OpenAI transcription for the Tushuntir checkpoint, Edge voices for Sardor
STT_PROVIDER=openai
STT_API_KEY=
STT_MODEL=gpt-transcribe
STT_TIMEOUT_MS=60000
TTS_VOICE=uz-UZ-SardorNeural
# Optional: a system ffmpeg instead of the one the ffmpeg-static package downloads
FFMPEG_PATH=

# School time
APP_TIMEZONE=Asia/Tashkent
# Local time a lesson quiz closes on the lesson's day
QUIZ_DEADLINE_TIME=22:00

# Demo: npm run seed:mvp sets this password for the demo users;
# DEMO_MODE=true enables POST /api/demo/finish-lesson/:lessonId and auto-approves generated questions
SEED_DEMO_PASSWORD=
DEMO_MODE=false

# Basic auth for Swagger UI at /api/docs (required in production, else the docs are off;
# locally it falls back to admin/secret)
SWAGGER_USER=
SWAGGER_PASSWORD=
